<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SpaceRace.ViewModels"
             x:Class="SpaceRace.Views.InventoryDialog"
             x:DataType="vm:MainViewModel"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>
        
    <Border Background="{DynamicResource SystemRegionColor}">
        <Grid RowDefinitions="Auto,*">
            <TextBlock Text="Inventory" Grid.Row="0" Padding="4, 2" FontSize="20" FontWeight="Bold" />
            
            <Grid ColumnDefinitions="2*,*" RowDefinitions="*,Auto" ColumnSpacing="10" Grid.Row="1">
                <TableView ItemsSource="{Binding Session.State.ComponentDefs}" Grid.Column="0" Grid.Row="0">
                    <TableView.Columns>
                        <TableViewColumn Header="Name" Binding="{Binding Name}"/>
                        <TableViewColumn Header="Type" Binding="{Binding Type}" Width="80" />
                        <TableViewColumn Header="Price" Binding="{Binding Price}" Width="50" />
                        <TableViewColumn Header="Mass" Binding="{Binding Mass}" Width="50" />
                        <TableViewColumn Header="Description" Binding="{Binding Description}"/>
                    </TableView.Columns>
                </TableView>
                <TableView ItemsSource="{Binding Session.State.Inventory}" Grid.Column="1" Grid.Row="0">
                    <TableView.Columns>
                        <TableViewColumn Header="Name" Binding="{Binding Def.Name}"/>
                        <TableViewColumn Header="Type" Binding="{Binding Def.Type}"/>
                        <TableViewColumn Header="Damaged" Binding="{Binding Damaged}"/>
                    </TableView.Columns>
                </TableView>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Column="0" Grid.Row="1">
                    <Button>Purchase</Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Column="1" Grid.Row="1">
                    <Button>Cancel</Button>
                    <Button>Assemble Spacecraft</Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>

</UserControl>
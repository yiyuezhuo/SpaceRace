<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SpaceRace.ViewModels"
             x:Class="SpaceRace.Views.ManeuverDialog"
             x:DataType="vm:MainViewModel"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>
        
    <Border Background="{DynamicResource SystemRegionColor}">
        <DockPanel>
            <TextBlock Text="Maneuver" Padding="4, 2" FontSize="20" FontWeight="Bold" DockPanel.Dock="Top" />
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Bottom">
                <Button Command="{Binding CancelManeuverDialogCommand}">Close</Button>
                <Button Command="{Binding ApplyManeuverCommand}">Maneuver</Button>
            </StackPanel>
            
            <StackPanel>
                <Label Content="Target Years" Target="TargetYearsNumericUpDown" />
                <NumericUpDown x:Name="TargetYearsNumericUpDown" Value="{Binding Session.State.PrepareManeuverState.TargetYears}" IsReadOnly="{Binding !!Session.State.PrepareManeuverState.AppliedThrust}" />
                
                <Label Content="Start Mass" Target="StartMassNumericUpDown" />
                <NumericUpDown x:Name="StartMassNumericUpDown" Value="{Binding Session.State.PrepareManeuverState.StartMass}" IsReadOnly="True" />

                <Label Content="Difficulty" Target="DifficultyNumericUpDown" />
                <NumericUpDown x:Name="DifficultyNumericUpDown" Value="{Binding Session.State.PrepareManeuverState.Route.Difficulty}" IsReadOnly="True" />

                <Label Content="Required Thrust" Target="RequiredThrustNumericUpDown" />
                <NumericUpDown x:Name="RequiredThrustNumericUpDown" Value="{Binding Session.State.PrepareManeuverState.RequiredThrust}" IsReadOnly="True" />

                <Label Content="Applied Thrust" Target="RequiredThrustNumericUpDown" />
                <NumericUpDown x:Name="AppliedThrustNumericUpDown" Value="{Binding Session.State.PrepareManeuverState.AppliedThrust}" IsReadOnly="True" />

                <ItemsControl x:Name="ThrusterItemsControl" ItemsSource="{Binding Session.State.PrepareManeuverState.Spacecraft.Thrusters}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button 
                                Content="{Binding FullDescription}"
                                Command="{Binding #ThrusterItemsControl.((vm:MainViewModel)DataContext).UseThrusterCommand}"
                                CommandParameter="{Binding .}"
                                Margin="4" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

        </DockPanel>
    </Border>

</UserControl>
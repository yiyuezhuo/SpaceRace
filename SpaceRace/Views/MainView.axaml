<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:SpaceRace.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SpaceRace.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="SpaceRace.Views.MainView"
             x:DataType="vm:MainViewModel">
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>
                
    <Grid>
        <DockPanel>
            <StackPanel Orientation="Vertical" Spacing="5" DockPanel.Dock="Right" Width="200">
                <Button Command="{Binding DoNextTurnCommand}">Next Turn</Button>
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto">
                    <TextBlock Text="Year:" Grid.Column="0" Grid.Row="0" />
                    <TextBlock Text="{Binding Session.State.Year}" Grid.Column="1" Grid.Row="0" />
                    <TextBlock Text="Funds:" Grid.Column="0" Grid.Row="1" />
                    <TextBlock Text="{Binding Session.State.Funds}" Grid.Column="1" Grid.Row="1" />
                    <TextBlock Text="Score:" Grid.Column="0" Grid.Row="2" />
                    <TextBlock Text="{Binding Session.State.Score}" Grid.Column="1" Grid.Row="2" />
                </Grid>

                <!-- <Grid RowDefinitions="Auto,Auto">
                    <Button Grid.Row="0" Command="{Binding OpenResearchDialogCommand}">Research</Button>
                    <Button Grid.Row="1" Command="{Binding OpenInventoryDialogCommand}">Inventory</Button>
                </Grid> -->

                <WrapPanel>
                    <Button Command="{Binding OpenResearchDialogCommand}">Research</Button>
                    <Button Command="{Binding OpenInventoryDialogCommand}">Inventory</Button>
                    <!-- <Button Command="{Binding OpenMissionDialogCommand}">Missions</Button> -->
                </WrapPanel>


                <TableView ItemsSource="{Binding SpacecraftsOfSelectedLocation}" SelectedItem="{Binding SelectedSpacecraft}" IsVisible="{Binding SelectedLocation, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TableView.Columns>
                        <TableViewColumn Header="Name" Binding="{Binding Name}" />
                        <TableViewColumn Header="Mass" Binding="{Binding Mass}" Width="50" />
                    </TableView.Columns>
                </TableView>
                
                <StackPanel IsVisible="{Binding SelectedSpacecraft, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock Text="Spacecraft's Component:" />
                    <ListBox ItemsSource="{Binding SelectedSpacecraft?.Components}" SelectionMode="Multiple" SelectedItems="{Binding SelectedComponentsOfSelectedSpacecraft}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FullDescription}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <WrapPanel>
                        <Button Command="{Binding DoManeuverCommand}">Maneuver</Button>
                        <Button Command="{Binding DoDockCommand}">Dock</Button>
                        <Button Command="{Binding DoSeparateCommand}">Separate</Button>
                        <Button Command="{Binding DoDisassembleCommand}">Disassemble</Button>
                        <Button Command="{Binding DoRepairCommand}">Repair</Button>
                        <Button Command="{Binding DoHealCommand}">Heal</Button>
                    </WrapPanel>
                </StackPanel>

                <TextBlock Text="{Binding LocationDescription}" TextWrapping="Wrap" />
            </StackPanel>

            <ScrollViewer>
                <Viewbox Stretch="Uniform">
                    <Grid Width="150" Height="110">
                        <Svg x:Name="MapSvg" Path="/Assets/Sol2.svg"
                            PointerPressed="Map_OnPointerPressed"/>
                        <!-- Selected cue & spacecraft indicator -->
                        <Canvas x:Name="MapOverlay" IsHitTestVisible="False">
                        </Canvas>
                    </Grid>
                </Viewbox>
            </ScrollViewer>
        </DockPanel>

        <local:ResearchDialog MaxWidth="600" MaxHeight="500" IsVisible="{Binding IsResearchDialogOpen}" />
        <local:InventoryDialog MaxWidth="800" MaxHeight="500" IsVisible="{Binding IsInventoryDialogOpen}"  />
        <local:MissionDialog MaxWidth="800" MaxHeight="500" IsVisible="{Binding IsMissionDialogOpen}" />
        <local:MessageDialog HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsMessageDialogOpen}" />
        <local:ManeuverDialog MaxWidth="800" MaxHeight="500" IsVisible="{Binding IsManeuverDialogOpen}" />
    </Grid>
    
    <!--
    <Grid ColumnDefinitions="2*,*,*" ColumnSpacing="1">
        <TableView ItemsSource="{Binding Session.State.ComponentDefs}" Grid.Column="0">
            <TableView.Columns>
                <TableViewColumn Header="Name" Binding="{Binding Name}"/>
                <TableViewColumn Header="Type" Binding="{Binding Type}" Width="80" />
                <TableViewColumn Header="Price" Binding="{Binding Price}" Width="50" />
                <TableViewColumn Header="Mass" Binding="{Binding Mass}" Width="50" />
                <TableViewColumn Header="Description" Binding="{Binding Description}"/>
